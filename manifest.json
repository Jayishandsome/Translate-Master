{
  "manifest_version": 3,
  "name": "翻訳 — Contextual Translator",
  "version": "2.0.0",
  "description": "黑白動漫風的網頁翻譯擴充功能，支援 Gemini / MiniMax / Kimi / OpenAI / DeepSeek / Claude 等多家模型。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "翻訳 設定"
  }
}
